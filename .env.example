# Copy to .env.local and fill in. Never commit .env.local. Set the same vars in the
# Vercel dashboard for production (not via the Vercel CLI).
# Everything is optional for local dev: with no keys, the app still runs and builds —
# benchmark writes are skipped and rate-limiting is a no-op.

# --- Supabase (Postgres via Prisma) ---
# Supabase → Project Settings → Database → Connection string (use the pooled "Transaction" URL for serverless).
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# Supabase → Project Settings → API (for Auth/Storage later)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Upstash Redis (rate limiting) ---
# amusing-hippo-92821 — Upstash → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Resend (email; powers OWNED broadcast to subscribers) ---
# Sending domain must be verified in Resend → Domains.
RESEND_API_KEY=""
# The verified sender identity, e.g. "The Ownership Index <hello@rncollins.com>"
RESEND_FROM=""

# --- Vercel API (OWNED v2.1 custom domains; server-to-server) ---
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# --- OWNED subdomains (v2.0); set once the brand domain is live ---
OWNED_ROOT_DOMAIN=""
