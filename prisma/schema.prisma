// The Ownership Graph — data foundation (v1.5+).
// The score is a projection of facts through a versioned methodology.
// Facts carry provenance and a trust tier; scores are immutable, reproducible
// events. This schema is the graph, not a quiz results table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MethodologyVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  publishedAt DateTime @default(now())
  aggregation String   @default("additive")
  weights     Json
  notes       String?
  scores      ScoreEvent[]
}

model Creator {
  id            String   @id @default(cuid())
  authUserId    String?  @unique
  createdAt     DateTime @default(now())
  displayName   String?
  region        String?
  archetype     String?
  primaryPlatform String?
  followerBand  String?
  consents      Consent[]
  facts         Fact[]
  assessments   Assessment[]
  scores        ScoreEvent[]
  slug          String?  @unique
  ownedHeadline String?
  ownedBio      String?
  customDomain  String?  @unique
  emailCapture  Boolean  @default(false)
  ownedPublished Boolean @default(false)
  ownedUpdatedAt DateTime?
  ownedLinks    OwnedLink[]
  posts         Post[]
}

model OwnedLink {
  id        String   @id @default(cuid())
  creator   Creator  @relation(fields: [creatorId], references: [id])
  creatorId String
  label     String
  url       String
  kind      String   @default("link")
  owned     Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([creatorId, position])
}

model Subscriber {
  id        String   @id @default(cuid())
  creatorId String
  email     String
  createdAt DateTime @default(now())
  unsubscribedAt DateTime?
  @@unique([creatorId, email])
  @@index([creatorId])
}

model Post {
  id          String    @id @default(cuid())
  creator     Creator   @relation(fields: [creatorId], references: [id])
  creatorId   String
  slug        String
  title       String
  body        String    @db.Text
  excerpt     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  broadcastAt DateTime?
  broadcastCount Int    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([creatorId, slug])
  @@index([creatorId, published, publishedAt])
}

model Nomination {
  id             String   @id @default(cuid())
  nomineeName    String
  nomineeOrg     String?
  nomineeRole    String?
  why            String   @db.Text
  nominatorEmail String?
  source         String   @default("web")
  status         String   @default("new")
  createdAt      DateTime @default(now())
  @@index([status, createdAt])
}

model ResearchSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  handle         String?
  source         String   @default("site")
  interest       String?
  consent        Boolean  @default(false)
  consentVersion String   @default("2026-07")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  unsubscribedAt DateTime?
  @@index([source, createdAt])
}

model PartnerInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  kind         String   @default("unspecified")
  message      String   @db.Text
  status       String   @default("new")
  createdAt    DateTime @default(now())
  @@index([status, createdAt])
}

model Guest {
  id            String    @id @default(cuid())
  name          String
  org           String?
  role          String?
  roleCreated   Boolean   @default(false)
  domain        String?
  indexScore    Int?
  band          String?
  createdAt     DateTime  @default(now())
  episodes      Episode[]
  @@index([domain])
}

model Episode {
  id          String   @id @default(cuid())
  guest       Guest    @relation(fields: [guestId], references: [id])
  guestId     String
  title       String
  youtubeUrl  String?
  venue       String   @default("stage")
  signal      String?  @db.Text
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([guestId])
}

model Org {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  roster    RosterEntry[]
}

model RosterEntry {
  id        String  @id @default(cuid())
  org       Org     @relation(fields: [orgId], references: [id])
  orgId     String
  creatorId String
  label     String?
  @@unique([orgId, creatorId])
}

model Consent {
  id        String   @id @default(cuid())
  creator   Creator  @relation(fields: [creatorId], references: [id])
  creatorId String
  scope     String
  version   String
  grantedAt DateTime @default(now())
  revokedAt DateTime?
}

model Fact {
  id                 String   @id @default(cuid())
  creator            Creator  @relation(fields: [creatorId], references: [id])
  creatorId          String
  subject            String
  predicate          String
  value              Float
  evidenceTier       Float    @default(0.4)
  source             String
  observedAt         DateTime @default(now())
  methodologyRelevant Boolean @default(true)
  supersedesId       String?
  consentScope       String?
  @@index([creatorId, predicate])
}

model Assessment {
  id             String   @id @default(cuid())
  creator        Creator? @relation(fields: [creatorId], references: [id])
  creatorId      String?
  createdAt      DateTime @default(now())
  instrument     String   @default("ownership")
  source         String   @default("self")
  responses      Json
  research       Json?
  methodologyVersion String?
  researchVersion String?
  anonymous      Boolean  @default(true)
  total          Int?
  overallBand    String?
  confidence     Float?
  scores         ScoreEvent[]
  @@index([instrument, createdAt])
}

model ScoreEvent {
  id                   String   @id @default(cuid())
  assessment           Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId         String
  creator              Creator?  @relation(fields: [creatorId], references: [id])
  creatorId            String?
  methodology          MethodologyVersion @relation(fields: [methodologyVersionId], references: [id])
  methodologyVersionId String
  total                Int
  overallBand          String
  dimensionScores      Json
  confidence           Float
  computedAt           DateTime @default(now())
  @@index([creatorId, computedAt])
}

// ---- Candidate instrument validation operations ----
// Contact details are kept on the participant record; public reporting uses studyCode.
// No candidate scores or assessment results are stored in this subsystem.
model ResearchParticipant {
  id                 String   @id @default(cuid())
  studyCode          String   @unique
  email              String   @unique
  name               String?
  ageEligible        Boolean
  remoteEligible     Boolean
  relevantExperience Boolean
  instrumentInterest String
  profile            Json
  accessNeeds        String?  @db.Text
  availability       Json
  consentVersion     String
  consentedAt        DateTime
  quotationConsent   Boolean  @default(false)
  recordingConsent   Boolean  @default(false)
  contactConsent     Boolean
  withdrawalTokenHash String  @unique
  status             String   @default("screened")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  withdrawnAt        DateTime?
  sessions           CognitiveInterviewSession[]
  @@index([status, createdAt])
}

model CognitiveInterviewSession {
  id                String   @id @default(cuid())
  participant       ResearchParticipant @relation(fields: [participantId], references: [id])
  participantId     String
  instrument        String
  candidateVersion  String
  round             Int
  status            String   @default("requested")
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  timezone          String?
  meetingLocation   String?
  researcherUserId  String?
  researcherEmail   String?
  consentReconfirmedAt DateTime?
  recordingUsed     Boolean  @default(false)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  codes              ResponseProcessCode[]
  @@index([instrument, round, status])
  @@index([participantId, createdAt])
}

model ResponseProcessCode {
  id          String   @id @default(cuid())
  session     CognitiveInterviewSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  itemId      String
  domain      String
  severity    String
  evidence    String   @db.Text
  proposedAction String?
  coderUserId String
  createdAt   DateTime @default(now())
  @@index([itemId, domain, severity])
  @@index([sessionId])
}

model InstrumentRevision {
  id               String   @id @default(cuid())
  instrument       String
  sourceVersion    String
  targetVersion    String
  itemId           String
  changeType       String
  beforeValue      Json
  afterValue       Json
  rationale        String   @db.Text
  evidenceCodeIds  Json
  decisionStatus   String   @default("proposed")
  proposedBy       String
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  @@unique([instrument, targetVersion, itemId])
  @@index([instrument, sourceVersion, decisionStatus])
}

model ValidationGateDecision {
  id             String   @id @default(cuid())
  instrument     String
  candidateVersion String
  gate           String
  status         String   @default("not_met")
  evidence       Json
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([instrument, candidateVersion, gate])
}

model PilotProtocolRecord {
  id                String   @id @default(cuid())
  instrument        String
  candidateVersion  String
  protocolVersion   String
  preregistrationUrl String?
  preregisteredAt   DateTime?
  analysisPlanHash  String
  samplingPlan      Json
  missingDataPlan   Json
  fairnessPlan      Json
  status            String   @default("draft")
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([instrument, candidateVersion, protocolVersion])
}

model InstrumentActivationDecision {
  id               String   @id @default(cuid())
  instrument       String
  candidateVersion String
  decision         String   @default("blocked")
  gateSnapshot     Json
  methodologyRecordUrl String?
  decidedBy        String?
  decidedAt        DateTime?
  createdAt        DateTime @default(now())
  @@unique([instrument, candidateVersion])
}


// ---- Observatory evidence architecture ----
// These records separate a case from the claims made about it and the evidence
// supporting each claim. Public visibility is controlled per record.
model ObservatoryCase {
  id                 String   @id @default(cuid())
  slug               String   @unique
  displayName        String
  caseType           String
  primaryField       String?
  jurisdiction       String?
  headline           String?
  summary            String?  @db.Text
  inclusionRationale String?  @db.Text
  roleBuiltFlag      Boolean  @default(false)
  verificationStatus String   @default("provisional")
  evidenceCoverage   Float?
  consentStatus      String   @default("public_evidence")
  publicStatus       String   @default("draft")
  firstObservedAt    DateTime?
  lastReviewedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  claims             ObservatoryClaim[]
  events             ObservatoryEvent[]
  relationshipsFrom  ObservatoryRelationship[] @relation("ObservatoryRelationshipFrom")
  relationshipsTo    ObservatoryRelationship[] @relation("ObservatoryRelationshipTo")
  observations       ObservatoryConstructObservation[]
  @@index([caseType, primaryField])
  @@index([verificationStatus, publicStatus])
}

model ObservatorySource {
  id              String   @id @default(cuid())
  url             String   @unique
  title           String
  publisher       String?
  sourceType      String
  publishedAt     DateTime?
  accessedAt      DateTime
  archivedUrl     String?
  primarySource   Boolean  @default(false)
  publicStatus    String   @default("internal")
  createdAt       DateTime @default(now())
  claims          ObservatoryClaimEvidence[]
  @@index([sourceType, primarySource])
}

model ObservatoryClaim {
  id                 String   @id @default(cuid())
  case               ObservatoryCase @relation(fields: [caseId], references: [id])
  caseId             String
  claimType          String
  statement          String   @db.Text
  constructId        String?
  epistemicStatus    String   @default("observed")
  verificationStatus String   @default("unreviewed")
  confidence         Float?
  permissibleLanguage String? @db.Text
  contradictionNote  String?  @db.Text
  publicStatus       String   @default("draft")
  observedAt         DateTime?
  lastReviewedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  evidence           ObservatoryClaimEvidence[]
  @@index([caseId, claimType])
  @@index([verificationStatus, publicStatus])
}

model ObservatoryClaimEvidence {
  id            String   @id @default(cuid())
  claim         ObservatoryClaim @relation(fields: [claimId], references: [id])
  claimId       String
  source        ObservatorySource @relation(fields: [sourceId], references: [id])
  sourceId      String
  supportType   String   @default("supports")
  exactPassage  String?  @db.Text
  locator       String?
  analystNote   String?  @db.Text
  createdAt     DateTime @default(now())
  @@unique([claimId, sourceId, supportType])
  @@index([sourceId])
}

model ObservatoryRelationship {
  id             String   @id @default(cuid())
  fromCase       ObservatoryCase @relation("ObservatoryRelationshipFrom", fields: [fromCaseId], references: [id])
  fromCaseId     String
  toCase         ObservatoryCase? @relation("ObservatoryRelationshipTo", fields: [toCaseId], references: [id])
  toCaseId       String?
  targetType     String
  targetName     String
  relationshipType String
  startedAt      DateTime?
  endedAt        DateTime?
  verificationStatus String @default("unreviewed")
  publicStatus   String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([fromCaseId, relationshipType])
  @@index([targetType, targetName])
}

model ObservatoryEvent {
  id                 String   @id @default(cuid())
  case               ObservatoryCase @relation(fields: [caseId], references: [id])
  caseId             String
  eventType          String
  title              String
  description        String?  @db.Text
  occurredAt         DateTime?
  precision          String   @default("unknown")
  verificationStatus String   @default("unreviewed")
  publicStatus       String   @default("draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([caseId, occurredAt])
}

model ObservatoryConstructObservation {
  id                 String   @id @default(cuid())
  case               ObservatoryCase @relation(fields: [caseId], references: [id])
  caseId             String
  constructId        String
  valueNumeric       Float?
  valueCategory      String?
  measurementMethod  String
  instrumentVersion  String?
  evidenceCoverage   Float?
  verificationStatus String   @default("unreviewed")
  observedAt         DateTime?
  publicStatus       String   @default("draft")
  createdAt          DateTime @default(now())
  @@index([caseId, constructId, observedAt])
}
