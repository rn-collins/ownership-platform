{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanic/annotated/1",
  "title": "Annotated: one branch per tool that uses this mechanic. A spec's data must match at least one branch.",
  "description": "Merged as anyOf branches (kit 0.2.0). Branches: c14-08. The validator's schema-lite reports the first error of each branch when none match.",
  "anyOf": [
    {
      "title": "c14-08",
      "description": "c14-08 (built/htw/c14-08, schema file mechanic-annotated-1.json, id mechanic/annotated/1). Annotated: one drawn figure in stages, with photographs and notes beside it (c14-08 mākāhā gate). Proposed for kit/schema/mechanics/annotated-1.json. It is kept beside the tool because tool folders may not edit kit/. The Edition 007 figure that also uses annotated should reuse or extend this shape.",
      "type": "object",
      "required": [
        "stages",
        "watch",
        "closingClaimId",
        "summaryClaimId",
        "schematicClaimId",
        "schematicLabel",
        "figures"
      ],
      "additionalProperties": false,
      "properties": {
        "closingClaimId": {
          "type": "string"
        },
        "summaryClaimId": {
          "type": "string"
        },
        "schematicClaimId": {
          "type": "string"
        },
        "schematicLabel": {
          "const": "Schematic drawn for this tool"
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "number",
              "size",
              "claimId",
              "figureId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "young",
                  "feeding",
                  "grown"
                ]
              },
              "label": {
                "type": "string"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "size": {
                "enum": [
                  "smaller",
                  "inside",
                  "larger"
                ]
              },
              "claimId": {
                "type": "string"
              },
              "figureId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "watch": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "figureId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "figureId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "file",
              "w",
              "h",
              "claimId",
              "sourceId",
              "credit",
              "illustrative",
              "alt",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "pattern": "^images/"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "claimId": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              },
              "credit": {
                "type": "string",
                "minLength": 5
              },
              "illustrative": {
                "type": "boolean"
              },
              "alt": {
                "type": "string",
                "minLength": 20
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
