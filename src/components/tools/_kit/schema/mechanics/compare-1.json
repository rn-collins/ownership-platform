{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanic/compare/1",
  "title": "Compare: one branch per tool that uses this mechanic. A spec's data must match at least one branch.",
  "description": "Merged as anyOf branches (kit 0.2.0). Branches: c14-04, c14-07. The validator's schema-lite reports the first error of each branch when none match.",
  "anyOf": [
    {
      "title": "c14-04",
      "description": "c14-04 (built/htw/c14-04, schema file mechanic.schema.json, id mechanic/compare/1). CompareView: three rules side by side, scenario controls and a provenance gate (c14-04). Proposed for kit/schema/mechanics/compare-1.json",
      "type": "object",
      "required": [
        "defaults",
        "provenance",
        "phrases",
        "cells",
        "images"
      ],
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object",
          "required": [
            "diff",
            "origin",
            "later",
            "checked"
          ],
          "additionalProperties": false,
          "properties": {
            "diff": {
              "enum": [
                "slight",
                "radical"
              ]
            },
            "origin": {
              "enum": [
                "hawaiian",
                "english"
              ]
            },
            "later": {
              "enum": [
                "none",
                "english",
                "hawaiian"
              ]
            },
            "checked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "phrases": {
          "type": "object",
          "required": [
            "kingdomLater",
            "gate"
          ],
          "additionalProperties": false,
          "properties": {
            "kingdomLater": {
              "type": "string"
            },
            "gate": {
              "type": "string"
            }
          }
        },
        "cells": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "object",
            "required": [
              "id",
              "column",
              "state",
              "text",
              "claimIds",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "column": {
                "enum": [
                  "kingdom",
                  "state",
                  "bill"
                ]
              },
              "state": {
                "enum": [
                  "stated",
                  "partly",
                  "not-stated"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 10
              },
              "claimIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "images": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "place",
              "file",
              "width",
              "height",
              "alt",
              "caption",
              "illustrative",
              "creator",
              "license",
              "sourcePage",
              "credit"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "place": {
                "enum": [
                  "lead",
                  "kingdom",
                  "state",
                  "bill",
                  "prov"
                ]
              },
              "file": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "alt": {
                "type": "string",
                "minLength": 20
              },
              "caption": {
                "type": "string"
              },
              "illustrative": {
                "type": "boolean"
              },
              "creator": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "licenseUrl": {
                "type": "string"
              },
              "sourcePage": {
                "type": "string"
              },
              "credit": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "title": "c14-07",
      "description": "c14-07 (built/htw/c14-07, schema file mechanic-compare-1.json, id mechanic/compare/1). Compare: a records-by-questions matrix with a state in every cell (c14-07 evidence finder). Proposed for kit/schema/mechanics/compare-1.json. It is kept beside the tool because tool folders may not edit kit/. If the Which text governs tool needs a different compare shape, rename this one matrix-1 and set mechanic to matrix.",
      "type": "object",
      "required": [
        "read",
        "states",
        "questions",
        "records",
        "cells",
        "figures"
      ],
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "string",
          "pattern": "^[A-Z][a-z]+ \\d{1,2}, \\d{4}$"
        },
        "states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "addresses",
                  "touches",
                  "none",
                  "unreviewed"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "short",
              "claimId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 8
              },
              "short": {
                "type": "string"
              },
              "claimId": {
                "type": "string"
              },
              "figureId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "figure2Id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "short",
              "title",
              "by",
              "when",
              "url",
              "sourceIds",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "short": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "sourceIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "figureId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "record",
              "question",
              "state",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "record": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "addresses",
                  "touches",
                  "none",
                  "unreviewed"
                ]
              },
              "reason": {
                "type": "string"
              },
              "claimId": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "searched": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "file",
              "w",
              "h",
              "claimId",
              "sourceId",
              "credit",
              "illustrative",
              "alt",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "pattern": "^images/"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "claimId": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              },
              "credit": {
                "type": "string",
                "minLength": 5
              },
              "illustrative": {
                "type": "boolean"
              },
              "alt": {
                "type": "string",
                "minLength": 20
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
