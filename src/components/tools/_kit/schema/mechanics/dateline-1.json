{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanic/dateline/1",
  "title": "Dateline: one branch per tool that uses this mechanic. A spec's data must match at least one branch.",
  "description": "Merged as anyOf branches (kit 0.2.0). Branches: c14-01, c14-12. The validator's schema-lite reports the first error of each branch when none match.",
  "anyOf": [
    {
      "title": "c14-01",
      "description": "c14-01 (built/htw/c14-01, schema file mechanic.schema.json, id mechanic/dateline/1). DateLine: dated items on one axis, group filters and a gap to a reference date (c14-01). Proposed for kit/schema/mechanics/dateline-1.json",
      "type": "object",
      "required": [
        "filing",
        "axis",
        "groups",
        "lead",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "filing": {
          "type": "object",
          "required": [
            "date",
            "label",
            "claimId"
          ],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "claimId": {
              "type": "string"
            }
          }
        },
        "axis": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer"
            },
            "to": {
              "type": "integer"
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "lead": {
          "$ref": "#/$defs/c14-01__image"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "date",
              "group",
              "kind",
              "title",
              "claimId",
              "notShown",
              "image",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "pattern": "^[A-Z][a-z]+ (\\d{1,2}, )?\\d{4}$"
              },
              "group": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "item",
                  "filing",
                  "grant"
                ]
              },
              "title": {
                "type": "string"
              },
              "claimId": {
                "type": "string"
              },
              "notShown": {
                "type": "string"
              },
              "image": {
                "$ref": "#/$defs/c14-01__image"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        }
      }
    },
    {
      "title": "c14-12",
      "description": "c14-12 (built/htw/c14-12, schema file data.schema.json, id mechanic/dateline/1). DateLine in lanes: dated and undated items kept in parallel lanes, each tied to a story sentence (c14-12 papaya system). To use the real validator, copy this file to kit/schema/mechanics/dateline-1.json.",
      "type": "object",
      "required": [
        "lead",
        "system",
        "lanes",
        "items",
        "cross",
        "people",
        "names",
        "groups",
        "caution",
        "images"
      ],
      "additionalProperties": false,
      "properties": {
        "lead": {
          "type": "object",
          "required": [
            "imageId"
          ],
          "additionalProperties": false,
          "properties": {
            "imageId": {
              "type": "string"
            }
          }
        },
        "system": {
          "type": "object",
          "required": [
            "claimId"
          ],
          "additionalProperties": false,
          "properties": {
            "claimId": {
              "type": "string"
            }
          }
        },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "lane",
              "label",
              "year",
              "month",
              "when",
              "claimId",
              "imageId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "lane": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "month": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              },
              "when": {
                "type": "string"
              },
              "claimId": {
                "type": "string"
              },
              "imageId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "cross": {
          "type": "object",
          "required": [
            "sunupClaimId",
            "kapohoClaimId",
            "rainbowClaimId",
            "imageId",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "sunupClaimId": {
              "type": "string"
            },
            "kapohoClaimId": {
              "type": "string"
            },
            "rainbowClaimId": {
              "type": "string"
            },
            "imageId": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "people": {
          "type": "object",
          "required": [
            "namesClaimId",
            "rolesClaimId",
            "missingClaimId",
            "laterClaimId"
          ],
          "additionalProperties": false,
          "properties": {
            "namesClaimId": {
              "type": "string"
            },
            "rolesClaimId": {
              "type": "string"
            },
            "missingClaimId": {
              "type": "string"
            },
            "laterClaimId": {
              "type": "string"
            }
          }
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "caution": {
          "type": "object",
          "required": [
            "claimId"
          ],
          "additionalProperties": false,
          "properties": {
            "claimId": {
              "type": "string"
            }
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "file",
              "width",
              "height",
              "alt",
              "caption",
              "creditLine",
              "license",
              "sourceId",
              "precision",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "alt": {
                "type": "string",
                "minLength": 20
              },
              "caption": {
                "type": "string"
              },
              "creditLine": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "licenseUrl": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              },
              "precision": {
                "enum": [
                  "precise",
                  "illustrative"
                ]
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "c14-01__image": {
      "type": "object",
      "required": [
        "file",
        "width",
        "height",
        "alt",
        "caption",
        "illustrative",
        "creator",
        "license",
        "sourcePage",
        "credit"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "alt": {
          "type": "string",
          "minLength": 20
        },
        "caption": {
          "type": "string"
        },
        "illustrative": {
          "type": "boolean"
        },
        "creator": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "licenseUrl": {
          "type": "string"
        },
        "sourcePage": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        }
      }
    }
  }
}
