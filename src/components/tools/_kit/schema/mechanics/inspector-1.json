{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanic/inspector/1",
  "title": "Inspector: one branch per tool that uses this mechanic. A spec's data must match at least one branch.",
  "description": "Merged as anyOf branches (kit 0.2.0). Branches: c14-06. The validator's schema-lite reports the first error of each branch when none match.",
  "anyOf": [
    {
      "title": "c14-06",
      "description": "c14-06 (built/htw/c14-06, schema file mechanic-inspector-1.json, id mechanic/inspector/1). Inspector: text in, a per-item table out (c14-06 ʻokina checker). Proposed for kit/schema/mechanics/inspector-1.json. It is kept beside the tool because tool folders may not edit kit/.",
      "type": "object",
      "required": [
        "maxChars",
        "chars",
        "vowels",
        "samples",
        "defaultSample",
        "figures"
      ],
      "additionalProperties": false,
      "properties": {
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "defaultSample": {
          "type": "string"
        },
        "chars": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "cp",
              "ch",
              "name",
              "category",
              "categoryWords",
              "kind",
              "claimId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "cp": {
                "type": "string",
                "pattern": "^[0-9A-F]{4,6}$"
              },
              "ch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "pattern": "^[A-Z][a-z]$"
              },
              "categoryWords": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "okina",
                  "lookalike",
                  "fontslot",
                  "kahako-combining",
                  "letter"
                ]
              },
              "claimId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "vowels": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "cp",
              "ch",
              "name",
              "base",
              "baseCh",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "cp": {
                "type": "string",
                "pattern": "^[0-9A-F]{4}$"
              },
              "ch": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "baseCh": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "text",
              "claimId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "claimId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "file",
              "w",
              "h",
              "claimId",
              "sourceId",
              "credit",
              "illustrative",
              "alt",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "pattern": "^images/"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "claimId": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              },
              "credit": {
                "type": "string",
                "minLength": 5
              },
              "illustrative": {
                "type": "boolean"
              },
              "alt": {
                "type": "string",
                "minLength": 20
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
