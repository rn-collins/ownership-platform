              "claimId",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "claimId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "approved",
                  "needs-rn"
