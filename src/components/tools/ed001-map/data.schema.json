{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanic/sheet-map/1",
  "title": "Sheet, four-column map with one container change (M1 Four questions map). Proposed addition to kit/schema/mechanics/sheet-1.json as an anyOf branch; the kit has no file for it yet.",
  "type": "object",
  "required": ["imageBase", "maxPerColumn", "maxItemLength", "images", "columns", "changes", "marks", "templates"],
  "additionalProperties": false,
  "properties": {
    "imageBase": { "type": "string", "pattern": "^/.*/$" },
    "maxPerColumn": { "type": "integer", "minimum": 1, "maximum": 10 },
    "maxItemLength": { "type": "integer", "minimum": 10, "maximum": 200 },
    "images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } },
    "lead": { "type": "object", "required": ["imageId"], "additionalProperties": false, "properties": { "imageId": { "type": "string" } } },
    "columns": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "required": ["id", "number", "name", "question", "body", "claimId", "bodyClaimId", "imageId", "status"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "number": { "type": "string" }, "name": { "type": "string" }, "question": { "type": "string" }, "body": { "type": "string" }, "claimId": { "type": "string" }, "bodyClaimId": { "type": "string" }, "imageId": { "type": "string" }, "status": { "enum": ["approved", "needs-rn"] } } } },
    "changes": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "required": ["id", "label", "ifPhrase", "imageId", "status"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "ifPhrase": { "type": "string" }, "imageId": { "type": "string" }, "status": { "enum": ["approved", "needs-rn"] } } } },
    "changesClaimId": { "type": "string" },
    "marks": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["id", "label", "imageId", "status"], "additionalProperties": false,
      "properties": { "id": { "enum": ["stays", "goes", "unsure"] }, "label": { "type": "string" }, "imageId": { "type": "string" }, "status": { "enum": ["approved", "needs-rn"] } } } },
    "templates": { "type": "object", "required": ["empty", "headlineChange", "headlineNone", "stays", "goes", "unsure", "unmarked", "everywhere", "none", "emptyColumn", "pickChange", "resultImageId", "emptyImageId"], "additionalProperties": false,
      "properties": { "empty": { "type": "string" }, "headlineChange": { "type": "string" }, "headlineNone": { "type": "string" }, "stays": { "type": "string" }, "goes": { "type": "string" }, "unsure": { "type": "string" }, "unmarked": { "type": "string" }, "everywhere": { "type": "string" }, "none": { "type": "string" }, "emptyColumn": { "type": "string" }, "pickChange": { "type": "string" }, "resultImageId": { "type": "string" }, "emptyImageId": { "type": "string" } } },
    "cases": { "type": "array", "items": { "type": "object", "required": ["sourceId", "label", "status"], "additionalProperties": false, "properties": { "sourceId": { "type": "string" }, "label": { "type": "string" }, "status": { "enum": ["approved", "needs-rn"] } } } },
    "edition": { "type": "object", "required": ["claimId"], "additionalProperties": false, "properties": { "claimId": { "type": "string" } } }
  },
  "$defs": {
    "image": { "type": "object", "required": ["id", "file", "width", "height", "alt", "creator", "licence", "sourcePage", "precision", "kind", "status"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "file": { "type": "string", "pattern": "\\.jpg$" }, "width": { "type": "integer", "minimum": 200 }, "height": { "type": "integer", "minimum": 200 },
        "alt": { "type": "string", "minLength": 20 }, "creator": { "type": "string", "minLength": 2 },
        "licence": { "enum": ["CC0", "CC BY 2.0", "CC BY 3.0", "CC BY 4.0", "CC BY-SA 2.0", "CC BY-SA 3.0", "CC BY-SA 4.0", "Public domain"] },
        "licenceUrl": { "type": "string" }, "sourcePage": { "type": "string", "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:" },
        "precision": { "enum": ["precise", "illustrative"] }, "kind": { "enum": ["photo"] }, "status": { "enum": ["approved", "needs-rn"] } } }
  }
}
